<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Campus Connect</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .sidebar { min-height: calc(100vh - 56px); background: #1a1a2e; }
        .sidebar .nav-link { color: #adb5bd; padding: .6rem 1.2rem; border-radius: .375rem; }
        .sidebar .nav-link:hover, .sidebar .nav-link.active { color: #fff; background: rgba(255,255,255,.1); }
        .sidebar .nav-link i { width: 1.4rem; }
        .card { border: none; box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,.075); }
        .badge-Pendiente { background-color: #ffc107; color:#000; }
        .badge-Asignada { background-color: #0d6efd; }
        .badge-EnProceso { background-color: #fd7e14; }
        .badge-Cerrada { background-color: #198754; }
        .badge-Alta { background-color: #dc3545; }
        .badge-Media { background-color: #ffc107; color:#000; }
        .badge-Baja { background-color: #6c757d; }
        .timeline { position: relative; padding-left: 2rem; }
        .timeline::before { content:''; position:absolute; left:.75rem; top:0; bottom:0; width:2px; background:#dee2e6; }
        .timeline-item { position: relative; margin-bottom: 1.5rem; }
        .timeline-icon { position:absolute; left:-2rem; width:1.5rem; height:1.5rem; border-radius:50%; background:#0d6efd; display:flex; align-items:center; justify-content:center; color:#fff; font-size:.7rem; }
        .toast-container { z-index: 9999; }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="navbar navbar-dark bg-dark px-3 sticky-top">
            <a class="navbar-brand fw-bold" href="/"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Campus Connect</a>
            <div class="d-flex align-items-center gap-3">
                <span class="text-light small"><i class="bi bi-person-circle me-1"></i>@User.Identity.Name</span>
                <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light"><i class="bi bi-box-arrow-right me-1"></i>Salir</button>
                </form>
            </div>
        </nav>
        <div class="container-fluid">
            <div class="row">
                <nav class="col-md-2 sidebar py-3 d-none d-md-block">
                    @if (User.IsInRole("Administrativo"))
                    {
                        <ul class="nav flex-column gap-1">
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Recursos" ? "active" : "")" asp-controller="Admin" asp-action="Recursos"><i class="bi bi-box-seam"></i> Recursos</a></li>
                            <li class="nav-item"><a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Reportes" ? "active" : "")" asp-controller="Admin" asp-action="Reportes"><i class="bi bi-bar-chart-line"></i> Reportes</a></li>
                        </ul>
                    }
                    else if (User.IsInRole("Estudiante"))
                    {
                        <ul class="nav flex-column gap-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="Estudiante" asp-action="Index"><i class="bi bi-list-ul"></i> Mis Solicitudes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Estudiante" asp-action="CrearSolicitud"><i class="bi bi-plus-circle"></i> Nueva Solicitud</a></li>
                        </ul>
                    }
                    else if (User.IsInRole("ResponsableTecnico"))
                    {
                        <ul class="nav flex-column gap-1">
                            <li class="nav-item"><a class="nav-link" asp-controller="Tecnico" asp-action="MisSolicitudes"><i class="bi bi-tools"></i> Mis Asignaciones</a></li>
                        </ul>
                    }
                </nav>
                <main class="col-md-10 py-4 px-4">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @RenderBody()
                </main>
            </div>
        </div>
    }
    else
    {
        @RenderBody()
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        // Inicializar DataTables automáticamente
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.datatable').forEach(function (el) {
                new DataTable(el, { language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' } });
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

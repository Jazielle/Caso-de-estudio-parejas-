@using CampusConnect.Core.DTOs
@model List<SolicitudResponseDto>
@{
    ViewData["Title"] = "Mis Solicitudes Asignadas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-tools me-2 text-primary"></i>Mis Solicitudes Asignadas</h4>
</div>

@if (!Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
            <h5 class="mt-3 text-muted">No tienes solicitudes asignadas actualmente.</h5>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover datatable mb-0">
                <thead class="table-dark">
                    <tr><th>#</th><th>Título</th><th>Estudiante</th><th>Estado</th><th>Prioridad</th><th>Fecha</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td>@s.Titulo</td>
                            <td>@s.EstudianteNombre</td>
                            <td><span class="badge badge-@s.Estado rounded-pill">@s.Estado</span></td>
                            <td><span class="badge badge-@s.Prioridad rounded-pill">@s.Prioridad</span></td>
                            <td>@s.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-controller="Tecnico" asp-action="Detalle" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-primary"><i class="bi bi-eye me-1"></i>Gestionar</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

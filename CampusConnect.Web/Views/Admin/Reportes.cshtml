@using CampusConnect.Core.DTOs
@model ReporteKpiDto
@{
    ViewData["Title"] = "Reportes y Analítica";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Reportes y KPIs</h4>
</div>

<!-- KPI Principal -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-center border-primary border-top border-3">
            <div class="card-body">
                <i class="bi bi-inbox-fill text-primary fs-2 mb-2"></i>
                <h2 class="fw-bold text-primary">@Model.TotalRecibidas</h2>
                <p class="text-muted mb-0">Solicitudes Recibidas</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-warning border-top border-3">
            <div class="card-body">
                <i class="bi bi-hourglass text-warning fs-2 mb-2"></i>
                <h2 class="fw-bold text-warning">@Model.TotalPendientes</h2>
                <p class="text-muted mb-0">Pendientes</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-success border-top border-3">
            <div class="card-body">
                <i class="bi bi-check-all text-success fs-2 mb-2"></i>
                <h2 class="fw-bold text-success">@Model.TotalCerradas</h2>
                <p class="text-muted mb-0">Cerradas</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center border-info border-top border-3">
            <div class="card-body">
                <i class="bi bi-clock text-info fs-2 mb-2"></i>
                <h2 class="fw-bold text-info">@Model.TiempoPromedioAtencionHoras h</h2>
                <p class="text-muted mb-0">Tiempo Promedio Atención</p>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Gráfico de barras (canvas) -->
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-bar-chart me-2"></i>Resumen de Solicitudes</div>
            <div class="card-body d-flex align-items-center justify-content-center">
                <canvas id="chartSolicitudes" style="max-height:280px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Tabla de responsables -->
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header fw-bold"><i class="bi bi-people me-2"></i>Responsables Técnicos</div>
            <div class="card-body p-0">
                @if (!Model.ResponsablesAsignados.Any())
                {
                    <p class="text-muted text-center py-4">No hay responsables registrados.</p>
                }
                else
                {
                    <table class="table table-sm mb-0">
                        <thead class="table-light">
                            <tr><th>Nombre</th><th>Asignadas</th><th>Cerradas</th><th>Eficiencia</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.ResponsablesAsignados)
                            {
                                var eficiencia = r.SolicitudesAsignadas > 0
                                    ? (int)((r.SolicitudesCerradas * 100.0) / r.SolicitudesAsignadas)
                                    : 0;
                                <tr>
                                    <td>@r.Nombre</td>
                                    <td>@r.SolicitudesAsignadas</td>
                                    <td>@r.SolicitudesCerradas</td>
                                    <td>
                                        <div class="progress" style="height:16px;min-width:60px;">
                                            <div class="progress-bar bg-success" style="width:@eficiencia%">@eficiencia%</div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const ctx = document.getElementById('chartSolicitudes');
    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Recibidas', 'Pendientes', 'Cerradas'],
            datasets: [{
                label: 'Solicitudes',
                data: [@Model.TotalRecibidas, @Model.TotalPendientes, @Model.TotalCerradas],
                backgroundColor: ['#0d6efd', '#ffc107', '#198754'],
                borderRadius: 6
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
        }
    });
</script>
}

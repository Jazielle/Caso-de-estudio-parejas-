@using CampusConnect.Core.DTOs
@using CampusConnect.Core.Enums
@{
    ViewData["Title"] = "Dashboard Administrativo";
    var solicitudes = ViewBag.Solicitudes as List<SolicitudResponseDto> ?? new();
    var estados = (EstadoSolicitud[])ViewBag.Estados;
    var prioridades = (PrioridadSolicitud[])ViewBag.Prioridades;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-speedometer2 me-2 text-primary"></i>Dashboard Administrativo</h4>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    @{
        var total = solicitudes.Count;
        var pendientes = solicitudes.Count(s => s.Estado == "Pendiente");
        var enProceso = solicitudes.Count(s => s.Estado is "Asignada" or "EnProceso");
        var cerradas = solicitudes.Count(s => s.Estado == "Cerrada");
    }
    <div class="col-md-3">
        <div class="card border-start border-primary border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div><div class="text-muted small">Total Solicitudes</div><h3 class="fw-bold mb-0">@total</h3></div>
                <i class="bi bi-inbox-fill text-primary" style="font-size:2rem;opacity:.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-warning border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div><div class="text-muted small">Pendientes</div><h3 class="fw-bold mb-0">@pendientes</h3></div>
                <i class="bi bi-hourglass-split text-warning" style="font-size:2rem;opacity:.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-info border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div><div class="text-muted small">En Proceso</div><h3 class="fw-bold mb-0">@enProceso</h3></div>
                <i class="bi bi-gear-wide-connected text-info" style="font-size:2rem;opacity:.4;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-start border-success border-4">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div><div class="text-muted small">Cerradas</div><h3 class="fw-bold mb-0">@cerradas</h3></div>
                <i class="bi bi-check-circle-fill text-success" style="font-size:2rem;opacity:.4;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Filtros -->
<div class="card mb-3">
    <div class="card-body py-2">
        <form asp-controller="Admin" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label small mb-1">Estado</label>
                <select name="estado" class="form-select form-select-sm">
                    <option value="">Todos</option>
                    @foreach (var e in estados)
                    {
                        <option value="@e" selected="@(ViewBag.EstadoFiltro == e.ToString())">@e</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label small mb-1">Prioridad</label>
                <select name="prioridad" class="form-select form-select-sm">
                    <option value="">Todas</option>
                    @foreach (var p in prioridades)
                    {
                        <option value="@p" selected="@(ViewBag.PrioridadFiltro == p.ToString())">@p</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-funnel me-1"></i>Filtrar</button>
                <a asp-controller="Admin" asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla -->
<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover datatable mb-0">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    <th>Título</th>
                    <th>Estudiante</th>
                    <th>Estado</th>
                    <th>Prioridad</th>
                    <th>Responsable</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in solicitudes)
                {
                    <tr>
                        <td>@s.Id</td>
                        <td>@s.Titulo</td>
                        <td>@s.EstudianteNombre</td>
                        <td><span class="badge badge-@s.Estado rounded-pill">@s.Estado</span></td>
                        <td><span class="badge badge-@s.Prioridad rounded-pill">@s.Prioridad</span></td>
                        <td>@(s.ResponsableNombre ?? "—")</td>
                        <td>@s.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td>
                            <a asp-controller="Admin" asp-action="DetalleSolicitud" asp-route-id="@s.Id"
                               class="btn btn-sm btn-primary"><i class="bi bi-pencil-square"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

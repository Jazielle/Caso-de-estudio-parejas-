@using CampusConnect.Core.DTOs
@using CampusConnect.Core.Enums
@model SolicitudResponseDto
@{
    ViewData["Title"] = "Detalle Solicitud #" + Model?.Id;
    var tecnicos = ViewBag.Tecnicos as List<dynamic> ?? new();
    var estados = (EstadoSolicitud[])ViewBag.Estados;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-file-text me-2 text-primary"></i>Solicitud #@Model?.Id — @Model?.Titulo</h4>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

@if (Model == null) { <div class="alert alert-danger">Solicitud no encontrada.</div> return; }

<div class="row g-4">
    <!-- Columna izquierda: detalles + acción -->
    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header fw-bold bg-dark text-white"><i class="bi bi-info-circle me-2"></i>Información</div>
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5">Estudiante</dt><dd class="col-7">@Model.EstudianteNombre</dd>
                    <dt class="col-5">Estado</dt><dd class="col-7"><span class="badge badge-@Model.Estado">@Model.Estado</span></dd>
                    <dt class="col-5">Prioridad</dt><dd class="col-7"><span class="badge badge-@Model.Prioridad">@Model.Prioridad</span></dd>
                    <dt class="col-5">Responsable</dt><dd class="col-7">@(Model.ResponsableNombre ?? "Sin asignar")</dd>
                    <dt class="col-5">Recurso</dt><dd class="col-7">@(Model.RecursoNombre ?? "—")</dd>
                    <dt class="col-5">Creada</dt><dd class="col-7">@Model.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</dd>
                </dl>
                <hr />
                <p class="small text-muted">@Model.Descripcion</p>
            </div>
        </div>

        <!-- Formulario de gestión -->
        <div class="card">
            <div class="card-header fw-bold bg-primary text-white"><i class="bi bi-sliders me-2"></i>Gestionar Solicitud</div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="ActualizarSolicitud" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Cambiar Estado</label>
                        <select name="Estado" class="form-select form-select-sm">
                            @foreach (var e in estados)
                            {
                                <option value="@((int)e)" selected="@(Model.Estado == e.ToString())">@e</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Asignar Responsable</label>
                        <select name="ResponsableId" class="form-select form-select-sm">
                            <option value="">— Sin cambiar —</option>
                            @foreach (var t in ViewBag.Tecnicos)
                            {
                                <option value="@t.Id">@t.Nombre</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small">Comentario <span class="text-danger">*</span></label>
                        <textarea name="Comentario" class="form-control form-control-sm" rows="3"
                                  placeholder="Escribe un comentario sobre esta actualización..." required></textarea>
                    </div>
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary btn-sm">
                            <i class="bi bi-save me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Columna derecha: evidencias + timeline -->
    <div class="col-lg-8">
        <!-- Evidencias -->
        @if (Model.Evidencias.Any())
        {
            <div class="card mb-3">
                <div class="card-header fw-bold"><i class="bi bi-images me-2"></i>Evidencias (@Model.Evidencias.Count)</div>
                <div class="card-body">
                    <div class="row g-2">
                        @foreach (var e in Model.Evidencias)
                        {
                            <div class="col-auto">
                                @if (e.TipoContenido.StartsWith("image/"))
                                {
                                    <a href="@e.RutaArchivo" target="_blank">
                                        <img src="@e.RutaArchivo" class="img-thumbnail" style="height:100px;object-fit:cover;" />
                                    </a>
                                }
                                else
                                {
                                    <a href="@e.RutaArchivo" target="_blank" class="btn btn-outline-danger btn-sm">
                                        <i class="bi bi-file-pdf me-1"></i>Ver PDF
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Timeline -->
        <div class="card">
            <div class="card-header fw-bold"><i class="bi bi-clock-history me-2"></i>Historial de Seguimiento</div>
            <div class="card-body">
                <div class="timeline">
                    @foreach (var sg in Model.Seguimientos.OrderByDescending(s => s.Fecha))
                    {
                        <div class="timeline-item">
                            <div class="timeline-icon bg-primary"><i class="bi bi-chat-left"></i></div>
                            <div class="card bg-light">
                                <div class="card-body py-2 px-3">
                                    <div class="d-flex justify-content-between">
                                        <strong class="small">@sg.AutorNombre</strong>
                                        <span class="text-muted small">@sg.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    @if (sg.EstadoAnterior != null && sg.EstadoNuevo != null)
                                    {
                                        <div class="my-1">
                                            <span class="badge text-bg-secondary">@sg.EstadoAnterior</span>
                                            <i class="bi bi-arrow-right mx-1 text-muted"></i>
                                            <span class="badge badge-@sg.EstadoNuevo">@sg.EstadoNuevo</span>
                                        </div>
                                    }
                                    <p class="mb-0 small">@sg.Comentario</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

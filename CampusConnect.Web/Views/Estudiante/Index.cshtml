@using CampusConnect.Core.DTOs
@model List<SolicitudResponseDto>
@{
    ViewData["Title"] = "Mis Solicitudes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-list-ul me-2 text-primary"></i>Mis Solicitudes</h4>
    <a asp-controller="Estudiante" asp-action="CrearSolicitud" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Nueva Solicitud
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card text-center py-5">
        <div class="card-body">
            <i class="bi bi-inbox text-muted" style="font-size:3rem;"></i>
            <h5 class="mt-3 text-muted">No tienes solicitudes aún</h5>
            <p class="text-muted">Crea tu primera solicitud para comenzar.</p>
            <a asp-controller="Estudiante" asp-action="CrearSolicitud" class="btn btn-primary mt-2">Crear solicitud</a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover datatable mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Título</th>
                        <th>Estado</th>
                        <th>Prioridad</th>
                        <th>Responsable</th>
                        <th>Fecha</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td>@s.Titulo</td>
                            <td><span class="badge badge-@s.Estado rounded-pill">@s.Estado</span></td>
                            <td><span class="badge badge-@s.Prioridad rounded-pill">@s.Prioridad</span></td>
                            <td>@(s.ResponsableNombre ?? "<em>Sin asignar</em>")</td>
                            <td>@s.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td>
                                <a asp-controller="Estudiante" asp-action="Seguimiento" asp-route-id="@s.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i> Ver
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

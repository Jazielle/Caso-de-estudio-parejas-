@using CampusConnect.Core.DTOs
@using CampusConnect.Core.Enums
@model CrearSolicitudDto
@{
    ViewData["Title"] = "Nueva Solicitud";
    var recursos = ViewBag.Recursos as List<RecursoResponseDto> ?? new();
    var prioridades = (PrioridadSolicitud[])ViewBag.Prioridades;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="fw-bold mb-0"><i class="bi bi-plus-circle me-2 text-primary"></i>Crear Nueva Solicitud</h4>
    <a asp-controller="Estudiante" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver
    </a>
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body p-4">
                <form asp-controller="Estudiante" asp-action="CrearSolicitud" method="post"
                      enctype="multipart/form-data" id="formSolicitud">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label fw-semibold">Título <span class="text-danger">*</span></label>
                        <input asp-for="Titulo" class="form-control" placeholder="Ej. Falla en computadora sala 301" maxlength="200" />
                        <span asp-validation-for="Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-semibold">Descripción <span class="text-danger">*</span></label>
                        <textarea asp-for="Descripcion" class="form-control" rows="5"
                                  placeholder="Describe detalladamente el problema o necesidad..." maxlength="2000"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                        <div class="form-text text-end" id="charCount">0 / 2000</div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Prioridad" class="form-label fw-semibold">Prioridad</label>
                            <select asp-for="Prioridad" class="form-select">
                                @foreach (var p in prioridades)
                                {
                                    <option value="@((int)p)">@p.ToString()</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="RecursoId" class="form-label fw-semibold">Recurso Relacionado</label>
                            <select asp-for="RecursoId" class="form-select">
                                <option value="">— Sin recurso específico —</option>
                                @foreach (var r in recursos)
                                {
                                    <option value="@r.Id">@r.Nombre (@r.Categoria)</option>
                                }
                            </select>
                        </div>
                    </div>

                    <hr class="my-4" />
                    <h6 class="fw-semibold mb-3"><i class="bi bi-paperclip me-2"></i>Adjuntar Evidencia (Opcional)</h6>
                    <div class="mb-3">
                        <input type="file" name="archivo" class="form-control"
                               accept="image/jpeg,image/png,image/gif,application/pdf" id="archivoInput" />
                        <div class="form-text">Formatos permitidos: JPG, PNG, GIF, PDF. Máximo 10 MB.</div>
                    </div>

                    <div id="previewArea" class="mb-3 d-none">
                        <img id="imgPreview" class="img-thumbnail" style="max-height:150px;" />
                        <span id="pdfName" class="text-muted small d-none"><i class="bi bi-file-pdf text-danger me-1"></i></span>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg" id="btnSubmit">
                            <i class="bi bi-send me-2"></i>Enviar Solicitud
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card bg-light">
            <div class="card-body">
                <h6 class="fw-bold"><i class="bi bi-info-circle me-2 text-primary"></i>Información</h6>
                <ul class="small text-muted ps-3">
                    <li>Tu solicitud será revisada por el equipo administrativo.</li>
                    <li>Recibirás actualizaciones en la sección de seguimiento.</li>
                    <li>Las solicitudes de <strong>alta prioridad</strong> se atienden primero.</li>
                    <li>Puedes adjuntar una imagen o PDF como evidencia del problema.</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Contador de caracteres
    const desc = document.getElementById('Descripcion');
    const counter = document.getElementById('charCount');
    desc?.addEventListener('input', () => counter.textContent = `${desc.value.length} / 2000`);

    // Preview archivo
    document.getElementById('archivoInput')?.addEventListener('change', function () {
        const file = this.files[0];
        const preview = document.getElementById('previewArea');
        if (!file) { preview.classList.add('d-none'); return; }
        preview.classList.remove('d-none');
        if (file.type.startsWith('image/')) {
            const reader = new FileReader();
            reader.onload = e => {
                document.getElementById('imgPreview').src = e.target.result;
                document.getElementById('imgPreview').classList.remove('d-none');
                document.getElementById('pdfName').classList.add('d-none');
            };
            reader.readAsDataURL(file);
        } else {
            document.getElementById('imgPreview').classList.add('d-none');
            const pdfSpan = document.getElementById('pdfName');
            pdfSpan.textContent = file.name;
            pdfSpan.classList.remove('d-none');
        }
    });

    // Prevenir doble submit
    document.getElementById('formSolicitud')?.addEventListener('submit', function () {
        document.getElementById('btnSubmit').disabled = true;
        document.getElementById('btnSubmit').innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Enviando...';
    });
</script>
}
